# PulseCheck Environment Variables Template
# Copy this file to .env for local development

# Configuration file path override
PULSECHECK_CONFIG=config/dataset.yaml

# PostgreSQL Container & Database Settings
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulsecheck_db
POSTGRES_USER=pulsecheck
POSTGRES_PASSWORD=pulsecheck_secret

# Alert Webhook URL (optional; if unset, webhook alerts are skipped)
ALERT_WEBHOOK_URL=

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
PULSECHECK_LOG_LEVEL=INFO
